# Runtime
ENV=dev
PORT=2345

# PostgreSQL
POSTGRES_DB=groceries
POSTGRES_USER=groceries_app
POSTGRES_PASSWORD=replace_with_a_random_password
DATABASE_URL=postgres://groceries_app:replace_with_a_random_password@postgres:5432/groceries?sslmode=disable

# Web Push
VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key
