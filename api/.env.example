# Runtime
ENV=dev
PORT=2345

# Shared with the notification service; generate with: openssl rand -hex 32
S2S_TOKEN=replace_with_the_same_random_token_in_both_services

# Use http://localhost:2346 when running both services directly on the host.
NOTIFICATIONS_SERVICE_URL=http://notifications:2346

# PostgreSQL
POSTGRES_DB=casita
POSTGRES_USER=casita_app
POSTGRES_PASSWORD=replace_with_a_random_password
DATABASE_URL=postgres://casita_app:replace_with_a_random_password@postgres:5432/casita?sslmode=disable

# Web Push
VAPID_PUBLIC_KEY=replace_with_your_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_your_vapid_private_key
