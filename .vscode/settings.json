{
  "runOnSave.commands": [
    {
      "languages": ["go"],
      "commandBeforeSaving": "go-inline-pgformatter.formatAllSql",
      "runIn": "vscode"
    }
  ],
  "goPgFormat.matchSpacing": true,
  "goPgFormat.pgFormatPath": "/home/franco/.local/share/pgformatter-5.10/pg_format",
  "goPgFormat.addTabs": 1,
  "files.associations": {
    "*.sql": "sql"
  },
  "sqlfluff.path": ["/home/franco/.local/bin/sqlfluff"],
  "sqlfluff.diagnosticSeverity": "error",
  "[sql]": {
    "editor.defaultFormatter": "xsw.vscode-sqlfluff-lsp",
    "editor.formatOnSave": false
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  }
}
